# Orbit Desktop App Environment Variables

# Environment: dev, staging, or prod
ORBIT_ENV=dev

# Backend server URL
VITE_GRPC_BASE_URL=http://localhost:3000

# App version (set automatically in CI)
VITE_ORBIT_VERSION=0.0.0-dev

# Better Auth
BETTER_AUTH_SECRET=your-secret-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/orbit

# Groq API (for AI features)
GROQ_API_KEY=your-groq-api-key

# Optional: Sentry error tracking
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Optional: PostHog analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Optional: GitHub OAuth (for integrations)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Composio (for integrations)
COMPOSIO_API_KEY=
