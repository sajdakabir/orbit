PORT=3000
# Set NODE_ENV=production for production deployment (enables secure cookies)
NODE_ENV=development
SECRET_KEY=my-secret
DB_HOST=localhost
DB_PORT=5432
DB_USER=devuser
DB_PASS=devpass
DB_NAME=devdb
DATABASE_URL=postgres://${DB_USER}:${DB_PASS}@${DB_HOST}:5432/${DB_NAME}
IP_SALT=random_value
REQUIRE_AUTH=true
SHOW_CLIENT_LOGS=false
SHOW_ALL_REQUEST_LOGS=false

# Better Auth Configuration
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
# BETTER_AUTH_URL should match your server's public URL (e.g., https://api.example.com)
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# CLIENT_URL is your frontend URL, used for CORS and trustedOrigins
CLIENT_URL=http://localhost:5173

# Auth0 (Legacy - can be removed when fully migrated to Better Auth)
AUTH0_DOMAIN="auth0_domain"
AUTH0_AUDIENCE="auth0_audience"
AUTH0_CLIENT_ID="auth0_client_id"
AUTH0_CALLBACK_URL=${AUTH0_AUDIENCE}/callback

GROQ_API_KEY="your_groq_api_key"
CEREBRAS_API_KEY="your_cerebras_api_key"

# Mem0 AI - User Style Memory (optional, enables style-adaptive dictation)
MEM0_API_KEY="your_mem0_api_key"

# S3/MinIO Configuration
BLOB_STORAGE_BUCKET=orbit-blob-storage
TIMING_BUCKET=orbit-timing-storage
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Stripe configurations
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
APP_PROTOCOL=orbit-dev
STRIPE_PUBLIC_BASE_URL=http://localhost:3000