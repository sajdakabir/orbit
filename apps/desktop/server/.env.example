# Orbit Server Environment Variables

PORT=3000
SECRET_KEY=your-secret-key

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-password
DB_NAME=orbit
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/orbit

# Better Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Groq API
GROQ_API_KEY=your-groq-api-key

# Optional: S3 Storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=

# Optional: GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Composio
COMPOSIO_API_KEY=

# Optional: MEM0
MEM0_API_KEY=
